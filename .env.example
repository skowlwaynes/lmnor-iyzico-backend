# iyzico Sandbox panelinden alınır. Gerçek değerleri GitHub'a yüklemeyin.
IYZICO_API_KEY=sandbox-xxxxxxxx
IYZICO_SECRET_KEY=sandbox-xxxxxxxx
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_MODE=sandbox

# Vercel proje adresi
BACKEND_URL=https://YOUR-PROJECT.vercel.app

# Framer sonuç sayfaları
FRAMER_SUCCESS_URL=https://lmnorofficial.com/payment-success
FRAMER_FAILURE_URL=https://lmnorofficial.com/payment-failed

# Virgülle ayrılmış izinli site adresleri
ALLOWED_ORIGINS=https://lmnorofficial.com,https://www.lmnorofficial.com,http://localhost:3000

# Rastgele, uzun bir gizli değer (en az 32 karakter)
CALLBACK_SIGNING_SECRET=replace-with-a-long-random-secret

# Neon entegrasyonu bunu Vercel'e otomatik ekler.
DATABASE_URL=postgresql://...

# Sipariş onay e-postaları
RESEND_API_KEY=re_xxxxxxxxx
# Testte varsayılan değer kullanılabilir. Canlıda doğrulanmış alan adınıza geçin.
RESEND_FROM=LMNOR <siparis@lmnorofficial.com>
# İsteğe bağlı; takip bağlantısı için kullanılır.
FRAMER_SITE_URL=https://lmnorofficial.com

# Güvenli sipariş yönetim paneli
# En az 12 karakter, tahmin edilmesi zor bir yönetici şifresi
ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Rastgele, en az 32 karakter; oturum tokenlarını imzalar
ADMIN_SESSION_SECRET=replace-with-a-different-long-random-secret
